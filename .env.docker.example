# Optional Compose overrides. Use: docker compose --env-file .env.docker ...
# Laravel continues to read the existing .env; do not copy SMTP secrets here.
DOCKER_APP_PORT=8080
DOCKER_VITE_PORT=5175
DOCKER_VITE_HOST=localhost
# DOCKER_APP_URL=http://localhost:8080
DOCKER_UID=1000
DOCKER_GID=1000
DOCKER_DB_DATABASE=al_commerce
DOCKER_DB_USERNAME=al_commerce_app
DOCKER_DB_PASSWORD=local-development-only
DOCKER_MYSQL_ROOT_PASSWORD=local-root-only
DOCKER_MAILPIT_PORT=8025
